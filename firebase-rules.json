{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$game": {
        "$code": {
          ".read": true,
          ".write": true,

          "size":  { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 11" },
          "board": { ".validate": "newData.isString() && newData.val().length <= 121" },
          "turn":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4" },
          "round": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "coin": {
          ".validate":
            "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && newData.val() >= (data.isNumber() ? data.val() : 0) && newData.val() - (data.isNumber() ? data.val() : 0) <= 250 && newData.parent().child('lastOdul').val() == now && (!data.parent().child('lastOdul').isNumber() || data.parent().child('lastOdul').val() + 10000 <= now) && newData.parent().child('gun/toplam').val() - (data.parent().child('gun/tarih').val() == newData.parent().child('gun/tarih').val() && data.parent().child('gun/toplam').isNumber() ? data.parent().child('gun/toplam').val() : 0) == newData.val() - (data.isNumber() ? data.val() : 0)"
        },

        "lastOdul": { ".validate": "newData.val() == now" },

        "gun": {
          "tarih":  { ".validate": "newData.isString() && newData.val().length == 10" },
          "toplam": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "$other": { ".validate": false }
        },

        "gunluk": {
          "$oyun": {
            "$gun": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500 && newData.val() >= (data.isNumber() ? data.val() : 0)"
            }
          }
        },

        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },

        "nickLower": {
          ".validate": "newData.isString() && root.child('nicks').child(newData.val()).val() === $uid"
        },

        "olusturuldu": { ".validate": "newData.isNumber()" },

        "$other": { ".validate": false }
      }
    },

    "nicks": {
      "$nick": {
        ".read":  true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $nick.matches(/^[a-z0-9çğıöşü_]{3,16}$/)"
      }
    },

    "board": {
      "$tur": {
        "$donem": {
          ".read": true,
          ".indexOn": "coin",

          "$uid": {
            ".write":
              "auth != null && auth.uid === $uid && ($tur === 'haftalik' || $tur === 'aylik') && $donem.matches(/^[0-9]{4}-(W[0-9]{2}|[0-9]{2})$/)",

            "coin": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() >= (data.isNumber() ? data.val() : 0) && newData.val() - (data.isNumber() ? data.val() : 0) <= 250"
            },
            "nick": {
              ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
            },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "sikayetler": {
      ".read": true,

      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['metin', 'isim', 'tarih'])",

        "metin": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1000" },
        "isim":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
        "uid":   { ".validate": "auth != null && newData.val() === auth.uid" },
        "tarih": { ".validate": "newData.val() == now" },

        "oylar": {
          "$oyveren": {
            ".write":    "auth != null && auth.uid === $oyveren",
            ".validate": "auth != null && auth.uid === $oyveren && newData.isNumber() && (newData.val() === 1 || newData.val() === -1)"
          }
        },

        "yanitlar": {
          "$yid": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid', 'nick', 'metin', 'tarih'])",

            "uid":   { ".validate": "auth != null && newData.val() === auth.uid" },
            "nick":  { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" },
            "metin": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
            "tarih": { ".validate": "newData.val() == now" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "puanlar": {
      ".read": true,
      "$uid": {
        ".write":    "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
      }
    },

    "haberler": {
      ".read": true,
      ".indexOn": "tarih",

      "$id": {
        ".write": "auth != null && root.child('yoneticiler').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['baslik', 'metin', 'durum', 'tarih'])",

        "baslik": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "metin":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1500" },
        "durum":  { ".validate": "newData.isString() && (newData.val() === 'geldi' || newData.val() === 'yapiliyor' || newData.val() === 'gelecek')" },
        "tarih":  { ".validate": "newData.isNumber() && newData.val() > 0" },
        "$other": { ".validate": false }
      }
    },

    "yoneticiler": {
      "$uid": {
        ".read":  true,
        ".write": false
      }
    }
  }
}
